{
  "name": "minibee-viewer",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "scripts": {
    "assetscompress": "node scripts/assetscompress.mjs",
    "build:local": "node scripts/build-local.mjs",
    "build:local:debug": "node scripts/build-local.mjs --debug",
    "build:android": "node scripts/build-android.mjs",
    "build:android:play": "node scripts/build-android.mjs --play",
    "tauri": "tauri",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "types:sync": "node scripts/sync-types.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "release:notes": "node scripts/update-release-notes.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
