{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minibee-Viewer",
  "identifier": "com.pantera.minibee-viewer",
  "build": {
    "beforeBuildCommand": "npm run version:sync && npm run assetscompress",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minibee Viewer",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://api.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src https://calendar.google.com; form-action 'none'"
    }
  },
  "bundle": {
    "publisher": "Pantera Polnocy",
    "homepage": "https://github.com/PanteraPolnocy/Minibee-Viewer",
    "shortDescription": "Minimalist client for Second Life",
    "longDescription": "A lightweight buzz into the infinite grid.",
    "category": "SocialNetworking",
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../README.md": "README.md",
      "../HELP.md": "HELP.md",
      "../PRIVACY.md": "PRIVACY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis/header.bmp",
        "sidebarImage": "icons/nsis/sidebar.bmp",
        "uninstallerHeaderImage": "icons/nsis/uninstall-header.bmp",
        "startMenuFolder": "Minibee Viewer"
      },
      "wix": {
        "bannerPath": "icons/wix/banner.bmp",
        "dialogImagePath": "icons/wix/dialog.bmp",
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBOUVCNzIwMUJGRjA4QjAKUldTd0NQOGJJTGVlcW5EUDJiS0dOYzBnMDVQNURVaWovQVQxYUNmNnF6dFVWZ2RRZGlIbUpaeFcK",
      "endpoints": [
        "https://github.com/PanteraPolnocy/Minibee-Viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
