<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules (android:dataExtractionRules in the manifest).
  Nothing is included and every domain is excluded, for cloud backup and for
  device-to-device transfer alike: the app's data folder holds settings.json
  (with the sealed MFA "remember this device" record), optional chat logs and
  the WebView's own storage, none of which should leave the device. Older
  releases are covered by android:allowBackup="false" and
  android:fullBackupContent="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
