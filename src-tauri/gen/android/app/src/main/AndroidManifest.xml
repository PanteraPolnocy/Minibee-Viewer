<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the SL circuit alive for the whole run (see ConnectionService).
         Holding a live game-server session is none of the predefined service
         types, so the service runs as specialUse: no time limit, and the use
         case is spelled out in the service's property below (and in the Play
         Console declaration). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Voice and parcel music keep playing while backgrounded: the service
         adds this type only while either is actually sounding. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Since Android 11 the microphone stays open in the background only for
         a foreground service of type microphone; API 34+ gates that type
         behind this permission. ConnectionService adds the type only while
         voice is connected and RECORD_AUDIO is granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Default-network tracking (MainActivity.watchNetwork): a wifi <-> LTE
         switch is reported to the core so a stranded circuit is caught at
         once. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice chat: the WebView's getUserMedia still needs the app permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- No Auto Backup: the data folder holds settings.json (the sealed MFA
         "remember this device" record, remembered username), optional chat
         logs and the WebView's storage. None of it should leave the device
         through Google's backup or a device-to-device transfer. allowBackup
         covers cloud backup; dataExtractionRules (API 31+) and
         fullBackupContent (older) exclude every domain from both paths. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.minibee_viewer"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The declared set is the ceiling; the service picks the actual types
             per startForeground() call: specialUse always, mediaPlayback while
             parcel music or voice is sounding, microphone only while voice is
             on and the permission is granted. -->
        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's live Second Life session open while the viewer is in the background: the connection to the virtual world's server is a UDP session the server drops after about a minute without traffic, there is no push service for this protocol, and the user expects chat and instant messages to keep arriving until they log out. Started only from the visible app, stopped on logout, close or swipe-away; always shown as an ongoing notification." />
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
